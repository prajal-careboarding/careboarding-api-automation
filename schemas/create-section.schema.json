{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Section Response",
  "description": "Response envelope for POST /onboarding/config/templates/:id/sections (201 Created)",
  "type": "object",
  "required": ["success", "message", "data"],
  "additionalProperties": false,
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "templateId",
          "organizationId",
          "name",
          "order",
          "isSystem",
          "isRepeatable",
          "isVisible",
          "requiredRole",
          "isRehireOnly"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "templateId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": ["string", "null"]
          },
          "order": {
            "type": "number"
          },
          "isSystem": {
            "type": "boolean"
          },
          "isRepeatable": {
            "type": "boolean"
          },
          "isVisible": {
            "type": "boolean"
          },
          "requiredRole": {
            "type": "string",
            "enum": ["ANY", "EMPLOYEE", "EMPLOYER"]
          },
          "isRehireOnly": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Template Response",
  "description": "Response envelope for POST /onboarding/config/templates (201 Created) - also covers template responses containing multiple sections",
  "type": "object",
  "required": ["success", "message", "data"],
  "additionalProperties": false,
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "message": {
      "type": "string"
    },
    "data": {
      "$ref": "#/definitions/template"
    }
  },
  "definitions": {
    "template": {
      "type": "object",
      "required": [
        "id",
        "entityId",
        "organizationId",
        "branchId",
        "name",
        "type",
        "version",
        "status",
        "isSystem",
        "sections",
        "signees",
        "positionTemplates",
        "conditionalRules",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "organizationId": {
          "type": "string",
          "format": "uuid"
        },
        "branchId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"]
        },
        "stateCode": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "ACTIVE", "ARCHIVED"]
        },
        "isSystem": {
          "type": "boolean"
        },
        "categoryId": {
          "type": ["string", "null"]
        },
        "categoryName": {
          "type": ["string", "null"]
        },
        "policyType": {
          "type": ["string", "null"]
        },
        "requiresAcknowledgement": {
          "type": ["boolean", "null"]
        },
        "config": {
          "type": ["object", "null"]
        },
        "effectiveFrom": {
          "type": ["string", "null"]
        },
        "effectiveUntil": {
          "type": ["string", "null"]
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/section"
          }
        },
        "signees": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "groupKey": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "deletedAt": {
          "type": ["string", "null"]
        },
        "positionTemplates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conditionalRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "category": {
          "type": ["object", "null"]
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "templateId",
        "organizationId",
        "name",
        "order",
        "isSystem",
        "isRepeatable",
        "isVisible",
        "requiredRole",
        "isRehireOnly"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "templateId": {
          "type": "string",
          "format": "uuid"
        },
        "organizationId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "number"
        },
        "isSystem": {
          "type": "boolean"
        },
        "isRepeatable": {
          "type": "boolean"
        },
        "isVisible": {
          "type": "boolean"
        },
        "requiredRole": {
          "type": "string",
          "enum": ["ANY", "EMPLOYEE", "EMPLOYER"]
        },
        "isRehireOnly": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        },
        "visibilityRules": {
          "type": ["object", "null"]
        }
      }
    }
  }
}
